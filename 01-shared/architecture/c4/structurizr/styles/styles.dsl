styles {
    element "Person" {
        shape person
        background #084C61
        color #FFFFFF
    }
    element "Software System" {
        background #177E89
        color #FFFFFF
    }
    element "Container" {
        background #DB3A34
        color #FFFFFF
    }
    element "Database" {
        shape cylinder
        background #5E548E
        color #FFFFFF
    }
    element "Storage" {
        shape cylinder
        background #5E548E
        color #FFFFFF
    }
    element "External System" {
        background #6C757D
        color #FFFFFF
    }
    element "Future" {
        opacity 60
        border dashed
    }
    element "V2/Future" {
        opacity 45
        border dashed
    }
}
