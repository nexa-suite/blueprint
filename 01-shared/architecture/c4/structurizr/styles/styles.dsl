styles {
    element "Person" {
        shape person
        background #084C61
        color #FFFFFF
    }
    element "Software System" {
        background #177E89
        color #FFFFFF
    }
    element "Container" {
        background #DB3A34
        color #FFFFFF
    }
    element "Database" {
        shape cylinder
        background #5E548E
        color #FFFFFF
    }
    element "Storage" {
        shape cylinder
        background #5E548E
        color #FFFFFF
    }
    element "External System" {
        background #6C757D
        color #FFFFFF
    }
    element "TARGET V1" {
        background #0F766E
        color #FFFFFF
    }
    element "AS-IS / TARGET" {
        background #B45309
        color #FFFFFF
    }
    element "Domain ownership mapping" {
