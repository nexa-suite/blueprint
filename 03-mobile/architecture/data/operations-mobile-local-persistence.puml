@startuml OperationsMobileLocalPersistence
title Operations Mobile — V1 Local Assistance (PROPOSED / RESEARCH VALIDATION PENDING)
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class LocalWorkItem <<Entity>> {
  -localWorkItemId: LocalWorkItemId
  -remoteReference: String
  -kind: WorkItemKind
  -state: LocalWorkItemState
  +saveHarmlessDraft(): void
  +markPending(): void
  +recordRetry(): void
}

class LocalEvidenceStaging <<Entity>> {
  -evidenceId: EvidenceId
  -remoteReference: String
  -contentHash: String
  -state: EvidenceState
  +stage(): void
  +retry(): void
}

class RetryMetadata <<Value Object>> {
  -operationId: OperationId
  -attempts: Integer
  -lastKnownVersion: String
  -state: RetryState
  +recordAttempt(): void
  +markConflict(): void
}

class FreshnessMetadata <<Value Object>> {
  -scope: String
  -sourceVersion: String
  -lastCheckedAt: Instant
  -staleAt: Instant
  +markStale(): void
}

class LocalStorageBoundary <<Domain Service>> {
  +persistHarmlessDraft(item: LocalWorkItem): void
  +stageEvidence(item: LocalEvidenceStaging): void
  +recordRetry(metadata: RetryMetadata): void
  +purgeAfterConfirmation(reference: String): void
}

LocalWorkItem "1" *-- "0..*" LocalEvidenceStaging : temporary evidence
LocalWorkItem "1" o-- "0..1" RetryMetadata : retry only
LocalWorkItem "1" o-- "0..1" FreshnessMetadata : advisory freshness
LocalStorageBoundary --> LocalWorkItem : local/non-authoritative

enum WorkItemKind <<Enum>>
enum LocalWorkItemState <<Enum>>
enum EvidenceState <<Enum>>
enum RetryState <<Enum>>

legend right
PROPOSED / RESEARCH VALIDATION PENDING
Technology: NOT SELECTED. Logical records only; no framework commitment.
LOCAL / NON-AUTHORITATIVE. Nexa remains authority for inventory, allocation,
pick, dispatch, Delivery, payment, authorization, POD and traceability.
V1 is online-first. Drafts, safe reads, temporary evidence and retry metadata
may survive interruption; no generic sync cursor or background sync engine.
endlegend
@enduml
