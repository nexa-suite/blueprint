@startuml BuyerMobileLocalPersistence
title Buyer Mobile — V1 Local Assistance (PROPOSED / RESEARCH VALIDATION PENDING)
hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class BuyerReceiptDraft <<Entity>> {
  -localDraftId: LocalDraftId
  -deliveryReference: String
  -buyerRelationshipReference: String
  -state: DraftState
  +saveHarmlessDraft(): void
  +markPending(): void
  +recordRetry(): void
}

class BuyerReceiptDraftLine <<Entity>> {
  -lineId: LocalDraftLineId
  -productReference: String
  -quantity: Decimal
  +changeQuantity(quantity: Decimal): void
}

class DeliveryReadCache <<Entity>> {
  -cacheId: CacheId
  -deliveryReference: String
  -sourceVersion: String
  -freshness: FreshnessState
  +refresh(): void
  +markStale(): void
}

class NotificationState <<Value Object>> {
  -notificationReference: String
  -targetReference: String
  -receivedAt: Instant
  -consumedAt: Instant
  +markConsumed(): void
}

class RetryMetadata <<Value Object>> {
  -operationId: OperationId
  -attempts: Integer
  -lastKnownVersion: String
  -state: RetryState
  +recordAttempt(): void
  +markConflict(): void
}

class LocalStorageBoundary <<Domain Service>> {
  +persistHarmlessDraft(draft: BuyerReceiptDraft): void
  +readDelivery(reference: String): DeliveryReadCache
  +recordRetry(metadata: RetryMetadata): void
}

BuyerReceiptDraft "1" *-- "0..*" BuyerReceiptDraftLine : quantities
BuyerReceiptDraft "1" o-- "0..1" RetryMetadata : retry only
LocalStorageBoundary o-- "0..*" DeliveryReadCache : recent read
LocalStorageBoundary o-- "0..*" NotificationState : local state
LocalStorageBoundary --> BuyerReceiptDraft : local/non-authoritative

enum DraftState <<Enum>>
enum FreshnessState <<Enum>>
enum RetryState <<Enum>>

legend right
PROPOSED / RESEARCH VALIDATION PENDING
Technology: NOT SELECTED. Logical records only; no framework commitment.
LOCAL / NON-AUTHORITATIVE. Nexa remains authority for Delivery, receipt,
payment, authorization, commitment and traceability.
V1 keeps recent Delivery/handoff reads, harmless receipt/discrepancy drafts,
freshness and notification state. No generic sync engine; no offline receipt.
endlegend
@enduml
