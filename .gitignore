# Independent application/runway/legacy checkouts; their Git histories and
# working trees remain outside the Blueprint publication boundary.
10-repositories/active/*/
10-repositories/runway/*/
10-repositories/legacy/*/

# Private or non-cleared reference material.
11-reference/library/
11-reference/bibliography/**/*.pdf
11-reference/bibliography/**/*.epub
91-reference/legacy/legacy-ecosystem-report/assets/
*.pdf
*.epub

# Academic source and rubric input are local-only; derived Markdown remains
# publishable under 90-academic.
90-academic/rubrics/
90-academic/rubrics/**
90-academic/**/*enunciado*.md
90-academic/**/*rubric*.pdf
90-academic/**/*course-source*.md
